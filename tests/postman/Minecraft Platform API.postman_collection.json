  "item": [
    {
      "name": "Minecraft Platform API",
      "item": [
        {
          "name": "https://httpbin.org/headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status is 200\", function (){\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"response is fast (under 2s)\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"body has a headers object\", function () {\r",
                  "    pm.expect(pm.response.json()).to.have.property(\"headers\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"my Authorization token was sent\", function () {\r",
                  "    pm.expect(pm.response.json().headers.Authorization).to.eql(\"Bearer my-secret-token-123\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer my-secret-token-123",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"title\": \"Chelsi's first post\",\r\n    \"body\": \"Learning Postman!\",\r\n    \"userId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://httpbin.org/headers",
              "protocol": "https",
              "host": [
                "httpbin",
                "org"
              ],
              "path": [
                "headers"
              ]
            }
          },
          "response": []
        }
      ]
    },
